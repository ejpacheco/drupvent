{#
/**
 * @file
 * Site branding: logo, name and slogan.
 */
#}
{% extends "block.html.twig" %}
{% block content %}
  <div class="site-branding">
    {% if site_logo %}
      <a href="{{ path('<front>') }}" rel="home">
        <img src="{{ site_logo }}" alt="{{ 'Home'|t }}" class="h-8 w-auto" />
      </a>
    {% endif %}
    <div>
      {% if site_name %}
        <a href="{{ path('<front>') }}" rel="home" class="site-branding__name">{{ site_name }}</a>
      {% endif %}
      {% if site_slogan %}
        <div class="site-branding__slogan">{{ site_slogan }}</div>
      {% endif %}
    </div>
  </div>
{% endblock %}
